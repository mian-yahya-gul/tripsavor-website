# Copy this file to .env.local (git-ignored) for local dev, and add the same
# keys under Vercel → Project Settings → Environment Variables for production.

# Powers the Contact and Group Tickets forms (src/app/api/lead/route.ts).
# Sign up at https://resend.com (free tier), create an API key, paste it here.
# Without this set, form submissions are logged server-side but not emailed.
RESEND_API_KEY=

# Optional: which inbox receives form submissions. Defaults to
# siteConfig.email (src/data/site.ts) if not set.
LEAD_TO_EMAIL=
