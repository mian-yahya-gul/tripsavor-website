# Local development reads secrets from `.dev.vars` (git-ignored) — see .dev.vars.example and
# ENVIRONMENT_VARIABLES.md. This file only documents optional variables for `next dev`.

# Powers the Contact / Group Tickets / callback emails (src/app/api/lead/route.ts).
# Create a key at https://resend.com (free tier). Without it, enquiries are still saved to D1.
RESEND_API_KEY=

# Optional inbox for enquiry emails. Defaults to siteConfig.email (src/data/site.ts).
LEAD_TO_EMAIL=
