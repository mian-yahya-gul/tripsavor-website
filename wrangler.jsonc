{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tripsavor",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "tripsavor"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tripsavor-db",
      "database_id": "8c811a45-4323-44c6-ae8b-f383b18e1832",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "UPLOADS",
      "bucket_name": "tripsavor-private"
    }
  ],
  "ratelimits": [
    { "name": "LEAD_LIMITER", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } },
    { "name": "UPLOAD_LIMITER", "namespace_id": "1002", "simple": { "limit": 10, "period": 60 } }
  ],
  // Non-secret admin config. Empty = admin is locked (fails closed). Fill in before go-live — see ADMIN.md.
  "vars": {
    "ADMIN_HOSTNAME": "",
    "CF_ACCESS_TEAM_DOMAIN": "",
    "CF_ACCESS_AUD": "",
    "ADMIN_EMAILS": ""
  },
  "observability": {
    "enabled": true
  }
}
